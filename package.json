{
  "name": "@datadog/datadog-backstage-plugins",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "config:check": "backstage-cli config:check --strict",
    "prettier:check": "prettier --check .",
    "deprecations": "backstage-cli repo list-deprecations",
    "spellcheck": "cspell --gitignore '**/*.{tsx,ts,yaml,md}'",
    "verify": "yarn clean && yarn spellcheck --no-progress && yarn lint:all && yarn config:check && yarn tsc && yarn deprecations && yarn test:all && yarn knip && yarn clean && echo '💙 - verified - 💙'",
    "new": "backstage-cli new"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.34.5",
    "@backstage/e2e-test-utils": "^0.1.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.4",
    "cspell": "^9.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest-canvas-mock": "^2.5.2",
    "knip": "^5.73.4",
    "node-gyp": "^12.1.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3"
  },
  "resolutions": {
    "isolated-vm": ">=6",
    "jsonpath-plus": ">=10",
    "koa": ">=2",
    "tough-cookie": ">=4",
    "markdown-it@npm:^14.1.0": "npm:^14.3.3",
    "@graphql-tools/executor-legacy-ws@npm:^1.1.19": "npm:^1.1.39",
    "@fastify/busboy@npm:^3.1.1": "npm:^3.2.5",
    "launch-editor@npm:^2.6.1": "npm:^2.14.2",
    "qs@npm:6.13.0": "npm:^6.17.1",
    "linkify-it@npm:^5.0.0": "npm:^5.0.2",
    "webpack-dev-server@npm:5.2.2": "npm:^5.2.7",
    "flatted@npm:3.3.3": "npm:^3.4.4",
    "flatted@npm:^3.2.7": "npm:^3.4.4",
    "flatted@npm:^3.2.9": "npm:^3.4.4",
    "flatted@npm:^3.3.3": "npm:^3.4.4",
    "isomorphic-git@npm:^1.23.0": "npm:^1.44.13",
    "browserslist@npm:^4.0.0": "npm:^4.29.5",
    "browserslist@npm:^4.18.1": "npm:^4.29.5",
    "browserslist@npm:^4.21.4": "npm:^4.29.5",
    "browserslist@npm:^4.24.0": "npm:^4.29.5",
    "smol-toml@npm:^1.5.2": "npm:^1.9.1",
    "picomatch@npm:^2.0.4": "npm:^2.3.2",
    "picomatch@npm:^2.2.1": "npm:^2.3.2",
    "picomatch@npm:^2.2.3": "npm:^2.3.2",
    "picomatch@npm:^2.3.1": "npm:^2.3.2",
    "picomatch@npm:^4.0.1": "npm:^4.0.7",
    "picomatch@npm:^4.0.2": "npm:^4.0.7",
    "picomatch@npm:^4.0.3": "npm:^4.0.7",
    "@remix-run/router@npm:1.23.1": "npm:^1.23.4",
    "react-router@npm:6.30.2": "npm:^6.30.6"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "setupFiles": [
      "jest-canvas-mock"
    ]
  },
  "packageManager": "yarn@4.10.3"
}
